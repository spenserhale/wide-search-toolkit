# wide-search vendor credentials. Only the vendors you configure are called.
# All keys are optional, but at least one vendor must be configured.
#
# This file is plaintext at rest. Prefer the OS keychain:
#   wide-search auth set exa                        # hidden prompt
#   pbpaste | wide-search auth set exa --stdin      # non-interactive
#   wide-search auth migrate                        # move keys from this file into the keychain
# Values here override the keychain, so delete migrated lines.

# Exa (free credits available): https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Tavily (free tier available): https://app.tavily.com/home
TAVILY_API_KEY=

# Parallel (free tier available): https://platform.parallel.ai
PARALLEL_API_KEY=

# Perplexity: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# DataForSEO: https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Z.AI: https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# Ollama Cloud: https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Firecrawl: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# TinyFish: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Optional tuning
# WIDE_SEARCH_VENDORS=exa,tavily,parallel,perplexity
# WIDE_SEARCH_TIMEOUT_MS=8000
# WIDE_SEARCH_MAX_PER_VENDOR=10
# WIDE_SEARCH_MAX_COST_USD=0.05
# WIDE_SEARCH_CACHE_TTL_MS=900000
# WIDE_SEARCH_CACHE_DIR=~/.cache/wide-search
# WIDE_SEARCH_OUTPUT=toon
# WIDE_SEARCH_FETCH_MAX_CHARS=20000
# WIDE_SEARCH_FETCH_TOTAL_MAX_CHARS=100000
# WIDE_SEARCH_FETCH_CONCURRENCY=4
# WIDE_SEARCH_FETCH_TIMEOUT_MS=15000
# WIDE_SEARCH_SNIPPET_CHARS=500
# WIDE_SEARCH_ALLOW_PRIVATE_HOSTS=0
# WIDE_SEARCH_USER_AGENT=wide-search/0.2.1
# WIDE_SEARCH_CONFIG_FILE=~/.config/wide-search/config.json
# WIDE_SEARCH_KEYCHAIN=0   # skip the OS keychain lookup
